
    private static final int ROWS = 4;
    private static final int COLS = 5;
    private static final int TOTAL_BEDS = 20;

    private static patient[] patients = new patient[50];
    private static int[] beds = new int[TOTAL_BEDS + 1];
    private static int patientCount = 0;
    private static int nextPatientID = 1;
    private static Scanner scanner = new Scanner(System.in);

    public static void main(String[] args) {

        int choice;

        do {
            System.out.println();
            System.out.println("===== BED MANAGEMENT =====");
            System.out.println("1. Register Patient");
            System.out.println("2. Allocate Bed to Inpatient");
            System.out.println("3. Release Bed / Discharge Patient");
            System.out.println("4. Display Complete Ward Layout");
            System.out.println("5. Display Available Beds");
            System.out.println("6. Display Occupied Beds");
            System.out.println("0. Exit");
            System.out.print("Enter choice: ");

            choice = scanner.nextInt();
            scanner.nextLine();

            switch (choice) {

                case 1:
                    registerPatient();
                    break;

                case 2:
                    allocateBed();
                    break;

                case 3:
                    releaseBed();
                    break;

                case 4:
                    displayWardLayout();
                    break;

                case 5:
                    displayAvailableBeds();
                    break;

                case 6:
                    displayOccupiedBeds();
                    break;

                case 0:
                    System.out.println("Exiting Bed Management.");
                    break;

                default:
                    System.out.println("Invalid choice. Please try again.");
            }

        } while (choice != 0);

        scanner.close();
    }

    public static void registerPatient() {

        if (patientCount >= patients.length) {
            System.out.println("Patient limit reached.");
            return;
        }

        System.out.print("Enter First Name: ");
        String fn = scanner.nextLine();

        System.out.print("Enter Last Name: ");
        String ln = scanner.nextLine();

        System.out.print("Enter Category [Inpatient/Outpatient/Emergency]: ");
        String category = scanner.nextLine();

        patients[patientCount] =
                new patient(nextPatientID, fn, ln, category);

        System.out.println("Patient registered with ID: " + nextPatientID);

        patientCount++;
        nextPatientID++;
    }

    public static void allocateBed() {

        System.out.print("Enter Patient ID to allocate bed: ");
        int id = scanner.nextInt();
        scanner.nextLine();

        patient p = getPatientByID(id);

        if (p == null) {
            System.out.println("Patient not found.");
            return;
        }

        if (!p.getPatientCategory().equalsIgnoreCase("Inpatient")) {
            System.out.println(
                    "Error: Only Inpatients may be allocated a hospital bed."
            );
            return;
        }

        if (p.getBedNumber() != 0) {
            System.out.println(
                    "Patient already has bed B"
                            + String.format("%02d", p.getBedNumber())
            );
            return;
        }

        int bed = findAvailableBed();

        if (bed == -1) {
            System.out.println("No beds available. Cannot allocate.");
            return;
        }

        beds[bed] = p.getPatientID();
        p.setBedNumber(bed);

        System.out.println(
                "Success! Bed B"
                        + String.format("%02d", bed)
                        + " allocated to "
                        + p.getFirstName()
        );
    }

    public static void releaseBed() {

        System.out.print("Enter Patient ID to discharge: ");
        int id = scanner.nextInt();
        scanner.nextLine();

        patient p = getPatientByID(id);

        if (p == null) {
            System.out.println("Patient not found.");
            return;
        }

        int bed = p.getBedNumber();

        if (bed == 0) {
            System.out.println("Patient does not have a bed.");
            return;
        }

        beds[bed] = 0;
        p.setBedNumber(0);

        System.out.println(
                "Bed B"
                        + String.format("%02d", bed)
                        + " released."
        );
    }
    
    public static void displayWardLayout() {

        System.out.println();
        System.out.println("--- COMPLETE WARD LAYOUT 4x5 ---");

        int bedNum = 1;

        for (int r = 0; r < ROWS; r++) {

            for (int c = 0; c < COLS; c++) {

                String status;

                if (beds[bedNum] == 0) {
                    status = "FREE";
                } else {
                    status = "OCC";
                }

                System.out.printf(
                        "B%02d[%s] ",
                        bedNum,
                        status
                );

                bedNum++;
            }

            System.out.println();
        }
    }

    public static void displayAvailableBeds() {

        System.out.print("\nAvailable Beds: ");

        boolean found = false;

        for (int i = 1; i <= TOTAL_BEDS; i++) {

            if (beds[i] == 0) {

                System.out.print(
                        "B" + String.format("%02d", i) + " "
                );

                found = true;
            }
        }

        if (!found) {
            System.out.print("None");
        }

        System.out.println();
    }

    public static void displayOccupiedBeds() {

        System.out.println("\nOccupied Beds:");

        boolean found = false;

        for (int i = 1; i <= TOTAL_BEDS; i++) {

            if (beds[i] != 0) {

                patient p = getPatientByID(beds[i]);

                if (p != null) {

                    System.out.println(
                            "B"
                                    + String.format("%02d", i)
                                    + " -> Patient ID: "
                                    + p.getPatientID()
                                    + " | "
                                    + p.getFirstName()
                                    + " "
                                    + p.getLastName()
                    );

                    found = true;
                }
            }
        }

        if (!found) {
            System.out.println("None");
        }
    }
    
    public static int findAvailableBed() {

        for (int i = 1; i <= TOTAL_BEDS; i++) {

            if (beds[i] == 0) {
                return i;
            }
        }

        return -1;
    }
    
    public static patient getPatientByID(int id) {

        for (int i = 0; i < patientCount; i++) {

            if (patients[i] != null
                    && patients[i].getPatientID() == id) {

                return patients[i];
            }
        }

        return null;
    }


void main() {
}


public class patient {

    private int patientID;
    private String firstName;
    private String lastName;
    private String patientCategory;
    private int bedNumber;
    
    public patient(int patientID, String firstName, String lastName, String patientCategory) {
        this.patientID = patientID;
        this.firstName = firstName;
        this.lastName = lastName;
        this.patientCategory = patientCategory;
        this.bedNumber = 0;
    }

    public int getPatientID() {
        return patientID;
    }

    public String getFirstName() {
        return firstName;
    }

    public String getLastName() {
        return lastName;
    }

    public String getPatientCategory() {
        return patientCategory;
    }

    public int getBedNumber() {
        return bedNumber;
    }

    public void setBedNumber(int bedNumber) {
        this.bedNumber = bedNumber;
    }

    @Override
    public String toString() {
        return "ID: " + patientID
                + " " + firstName
                + " " + lastName
                + " | Category: " + patientCategory
                + " | Bed: "
                + (bedNumber == 0 ? "N/A" : "B" + String.format("%02d", bedNumber));
    }
}
